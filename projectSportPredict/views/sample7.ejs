The next step is where the real power comes in. We're going to build the backend that receives the selected IDs and performs one operation on all of them.

Step 1 — Add the Route
In your adminRoutes.js, add this route before any dynamic routes like /:id:

router.post(
    "/predictions/bulk",
    allowRoles(ROLES.SUPERUSER, ROLES.ADMIN),
    predictionController.bulkAction
);
Important: Place it above routes like:

router.post("/predictions/:id/delete", ...)
or

router.get("/predictions/:id/edit", ...)
This avoids Express trying to interpret "bulk" as an :id.

Step 2 — Create the Controller
Inside:

controllers/admin/predictionController.js
add this new controller:

exports.bulkAction = async (req, res, next) => {

    try {

        let { predictionIds, action } = req.body;

        // Nothing selected
        if (!predictionIds) {

            req.flash(
                "warning",
                "Please select at least one prediction."
            );

            return res.redirect("/admin/predictions");

        }

        // Convert single checkbox to array
        if (!Array.isArray(predictionIds)) {

            predictionIds = [predictionIds];

        }

        switch (action) {

            case "won":

                await Prediction.updateMany(

                    {
                        _id: {
                            $in: predictionIds
                        }
                    },

                    {
                        status: "Won"
                    }

                );

                break;

            case "lost":

                await Prediction.updateMany(

                    {
                        _id: {
                            $in: predictionIds
                        }
                    },

                    {
                        status: "Lost"
                    }

                );

                break;

            case "void":

                await Prediction.updateMany(

                    {
                        _id: {
                            $in: predictionIds
                        }
                    },

                    {
                        status: "Void"
                    }

                );

                break;

            case "premium":

                await Prediction.updateMany(

                    {
                        _id: {
                            $in: predictionIds
                        }
                    },

                    {
                        isPremium: true
                    }

                );

                break;

            case "free":

                await Prediction.updateMany(

                    {
                        _id: {
                            $in: predictionIds
                        }
                    },

                    {
                        isPremium: false
                    }

                );

                break;

            case "delete":

                await Prediction.deleteMany({

                    _id: {

                        $in: predictionIds

                    }

                });

                break;

            default:

                req.flash(
                    "error",
                    "Invalid bulk action."
                );

                return res.redirect("/admin/predictions");

        }

        req.flash(

            "success",

            `${predictionIds.length} prediction(s) updated successfully.`

        );

        res.redirect("/admin/predictions");

    } catch (err) {

        next(err);

    }

};
