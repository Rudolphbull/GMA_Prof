const bcrypt = require("bcrypt");

const Prediction = require("../models/predictionModel");

const User = require("../models/userModel");

exports.newLogin = (req, res) => {
    res.render("login", {pageTitle: "Login"});
};

exports.newSignup = (req, res) => {
    res.render("signup", {pageTitle: "Signup"});
};

exports.login = async (req, res) => {

    try {
        
        // Validate input first
        if (!req.body.login || !req.body.password) {

            return res.render("failureLogin", {
                pageTitle: "Failure Login",

                message: "Invalid username/email or password."
            });

        }

        // Search for the user
        const user = await User.findOne({
            $or: [
                { username: req.body.login },
                { email: req.body.login }
            ]
        });

        // Check if user exists
        if (!user) {

            return res.render("failureLogin", {
                pageTitle: "Failure Login",

                message: "Invalid username/email or password."
            });

        }

        // Compare password
        const passwordMatch = await bcrypt.compare(
            req.body.password,
            user.password
        );

        if (!passwordMatch) {

            return res.render("failureLogin", {
                pageTitle: "Failure Login",

                message: "Invalid username/email or password.."
            });

        }

        // Create a session
        req.session.user = {
            _id: user._id,
            username: user.username.toLowerCase().trim(),
            email: user.email.toLowerCase().trim(),
            role: user.role || "user"
        };

        console.log("Session after login:", req.session.user);

        // Redirect to the dashboard
        res.redirect("/auth/premium");

    } catch (err) {

        console.error(err);

        res.render("failureLogin", {
            pageTitle: "Failure Login",

            message: "An unexpected error occurred."
        });

    }

};



exports.signup = async (req, res) => {

    try {


        if (
            !req.body.username.toLowerCase().trim() ||
            !req.body.email.toLowerCase().trim() ||
            !req.body.password ||
            !req.body.confirmPassword
        ) {

            return res.render("failure", {
                pageTitle: "Failure",

                message: "Password and Confirm Password does not Match."
            });

        }

        const hashedPassword =
            await bcrypt.hash(req.body.password, 10);


        const existingUser = await User.findOne({
                
            $or: [
                { username: req.body.username },
                { email: req.body.email.toLowerCase().trim() }
            ]
        });

        if (existingUser) {

            return res.render("failure", {
                pageTitle: "User Already Exists",

                message: "User Already Exists."
            });

        }

        const user = new User({

            username: req.body.username.toLowerCase().trim(),

            email: req.body.email.toLowerCase().trim(),

            password: hashedPassword,

            role: "user"

        });

        await user.save();

        res.render("success", {
            pageTitle: "Success"
        });

    }

    catch(err){

        console.error(err);

        return res.render("failure", {

            pageTitle: "Failure",

            message: "An unexpected error occurred."

        });

    }

};


exports.logout = (req, res) => {

    req.session.destroy((err) => {

        if (err) {
            console.error(err);
            return res.redirect("/");
        }

        res.clearCookie("connect.sid");
        res.redirect("/");

    });

};



