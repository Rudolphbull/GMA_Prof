<%- include("../partials/header") -%>

<section class="container py-5">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="mb-1">
                Manage Predictions
            </h1>

            <p class="mb-0">

                Showing

                <strong>
                    <%= predictions.length ? ((currentPage - 1) * limit) + 1 : 0 %>
                </strong>

                -

                <strong>
                    <%= ((currentPage - 1) * limit) + predictions.length %>
                </strong>

                of

                <strong>
                    <%= totalPredictions %>
                </strong>

                predictions

            </p>

        </div>

        <a
            href="/predictions/new"
            class="btn btn-success"
        >

            <i class="bi bi-plus-circle"></i>

            New Prediction

        </a>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0 text-white">

                <i class="bi bi-funnel"></i>

                Filter Predictions

            </h5>

        </div>


        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-check2-square me-2"></i>

                    Bulk Actions

                </h5>

            </div>


        
            <div class="card-body">

                <form
                    id="bulkActionForm"
                    method="POST"
                    action="/admin/predictions/bulk"
                >

                    <div class="row align-items-end mb-4">

                        <div class="col-md-8">

                            <label
                                for="bulkAction"
                                class="form-label text-light fw-semibold"
                            >

                                <i class="bi bi-lightning-charge"></i>

                                Action

                            </label>

                            <select
                                class="form-select"
                                id="bulkAction"
                                name="action"
                                required
                            >

                                <option value="">

                                    Select Action

                                </option>

                                <option value="won">

                                    Mark as Won

                                </option>

                                <option value="lost">

                                    Mark as Lost

                                </option>

                                <option value="void">

                                    Mark as Void

                                </option>

                                <option value="premium">

                                    Make Premium

                                </option>

                                <option value="free">

                                    Make Free

                                </option>

                                <option value="delete">

                                    Delete Selected

                                </option>

                            </select>

                        </div>

                        <div class="col-md-4 text-end">

                            <button
                                type="submit"
                                class="btn btn-success px-4"
                            >

                                <i class="bi bi-check-circle"></i>

                                Apply

                            </button>

                        </div>

                </div>

            


                <div class="card shadow">

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>

                                    <tr>

                                        <th style="width:40px;">

                                            <input
                                                type="checkbox"
                                                id="selectAll"
                                                class="form-check-input"
                                            >

                                        </th>
                                        <th>Match</th>
                                        <th>Prediction</th>
                                        <th>Odds</th>
                                        <th>Status</th>
                                        <th>Result</th>
                                        <th>Premium</th>
                                        <th>Kickoff</th>
                                        <th>Actions</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% if(predictions.length === 0){ %>

                                        <tr>

                                            <td colspan="9" class="text-center py-5">

                                                <h5>No predictions found.</h5>

                                                <p class="text-muted mb-0">

                                                    Try adjusting your search or filters.

                                                </p>

                                            </td>

                                        </tr>

                                    <% } else { %>

                                        <% predictions.forEach(prediction => { %>

                                            <tr>

                                                <td>

                                                    <!-- <input
                                                        type="checkbox"
                                                        name="predictionIds"
                                                        class="form-check-input prediction-checkbox"
                                                        value="<%= prediction._id %>"
                                                    > -->

                                                    <input
                                                        type="checkbox"
                                                        data-bulk-checkbox
                                                        value="<%= prediction._id %>"
                                                    >

                                                </td>

                                                <td>

                                                    <strong>

                                                        <%= prediction.homeTeam %>

                                                    </strong>

                                                    <br>

                                                    <small class="text-muted">

                                                        vs

                                                        <%= prediction.awayTeam %>

                                                    </small>

                                                    <br>

                                                    <small class="text-secondary">

                                                        <%= prediction.league %>

                                                    </small>

                                                </td>

                                                <td>

                                                    <%= prediction.prediction %>

                                                </td>

                                                <td>

                                                    <%= prediction.odds %>

                                                </td>

                                                <td>

                                                    <% if(prediction.status === "Won"){ %>

                                                        <span class="badge bg-success">

                                                            Won

                                                        </span>

                                                    <% } else if(prediction.status === "Lost"){ %>

                                                        <span class="badge bg-danger">

                                                            Lost

                                                        </span>

                                                    <% } else if(prediction.status === "Void"){ %>

                                                        <span class="badge bg-secondary">

                                                            Void

                                                        </span>

                                                    <% } else if(prediction.status === "Expired"){ %>

                                                        <span class="badge bg-dark">

                                                            Expired

                                                        </span>

                                                    <% } else { %>

                                                        <span class="badge bg-warning text-dark">

                                                            Pending

                                                        </span>

                                                    <% } %>

                                                </td>


                                                <td>

                                                    <%= prediction.result %>

                                                </td>

                                                <td>

                                                    <% if(prediction.isPremium){ %>

                                                        <span class="badge bg-success">

                                                            Premium

                                                        </span>

                                                    <% } else { %>

                                                        <span class="badge bg-primary">

                                                            Free

                                                        </span>

                                                    <% } %>

                                                </td>

                                                <td>

                                                    <%= new Date(prediction.kickoffTime).toLocaleString("en-NG") %>

                                                </td>

                                                <td>

                                                    <a
                                                        href="/predictions/<%= prediction._id %>/edit"
                                                        class="btn btn-warning btn-sm mb-1"
                                                    >

                                                        <i class="bi bi-pencil-square"></i>

                                                        Edit

                                                    </a>

                                                    <form
                                                        action="/admin/predictions/<%= prediction._id %>/delete"
                                                        method="POST"
                                                        class="d-inline delete-form"
                                                        data-title="Delete Prediction"
                                                        data-message="Are you sure you want to delete this prediction?"
                                                        data-item="<%= prediction.homeTeam %> vs <%= prediction.awayTeam %>"
                                                        data-button="Delete"
                                                        data-button-class="btn-danger"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="btn btn-danger btn-sm"
                                                        >

                                                            <i class="bi bi-trash"></i>

                                                            Delete

                                                        </button>

                                                    </form>
                                                    
                                                </td>

                                            </tr>

                                        <% }) %>

                                    <% } %>

                                </tbody>
                            </table>

                        </div>

                        
                        <% if (totalPages > 1) { %>

                            <nav class="mt-4">

                                <ul class="pagination justify-content-center">

                                    <!-- Previous -->

                                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">

                                        <a
                                            class="page-link"
                                            href="/admin/predictions?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>&premium=<%= premium %>&country=<%= country %>&league=<%= league %>&minOdds=<%= minOdds %>&maxOdds=<%= maxOdds %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&sort=<%= sort %>"
                                        >
                                            Previous
                                        </a>

                                    </li>

                                    <!-- Page Numbers -->

                                    <% for (let i = 1; i <= totalPages; i++) { %>

                                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                                            <a
                                                class="page-link"
                                                href="/admin/predictions?page=<%= i %>&search=<%= search %>&status=<%= status %>&premium=<%= premium %>&country=<%= country %>&league=<%= league %>&minOdds=<%= minOdds %>&maxOdds=<%= maxOdds %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&sort=<%= sort %>"
                                            >
                                                <%= i %>
                                            </a>

                                        </li>

                                    <% } %>

                                    <!-- Next -->

                                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">


                                            <a
                                                class="page-link"
                                                href="/admin/predictions?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>&premium=<%= premium %>&country=<%= country %>&league=<%= league %>&minOdds=<%= minOdds %>&maxOdds=<%= maxOdds %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&sort=<%= sort %>"
                                            >
                                                Next
                                            </a>

                                        </li>

                                </ul>

                            </nav>

                                    <% } %>

                        </form>
                        
                    </div>

                </div>

</section>

