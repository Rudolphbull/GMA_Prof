<!-- 
Codes for Exports.BulkAction -->


exports.bulkAction = async (req, res, next) => {

    try {

        let { user, action } = req.body;


        // Nothing selected
        if (!user) {

            req.flash(
                "warning",
                "Please select at least one user."
            );

            return res.redirect("/admin/users");

        }

        // Convert single checkbox to array
        if (!Array.isArray(user)) {

            user = [user];

        }

        
        let message = "";

        switch (action) {

            const users = await User.find(
                
                { _id: {$in: user } }

            );

            case "user":

                await User.updateMany(
                    { _id: { $in: user } },
                    { role: "user" }
                );

                await logActivity({
                    action: "Bulk Role Update",
                    description: `${user.length} users changed to User(s).`,
                    icon: "bi-check-circle-fill",
                    color: "success",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) updated successfully.`;
                break;

            case "superuser":

                 if (user.role === "superuser") {

                    await User.find(
                        { _id: { $in: user } },
                        { role: "superuser" }
                    );

                    const superUserCount = await User.countDocuments({

                        role: "superuser"

                    });

                    if (superUserCount === 1) {

                        const err = new Error(
                            "The last Superuser cannot be demoted or upgraded."
                        );

                        err.status = 403;

                        err.details =
                            "At least one Superuser account must remain in the system.";

                        return next(err);

                    }

                }

                await User.updateMany(
                    { _id: { $in: user } },
                    { role: "superuser" }
                );

                await logActivity({
                    action: "Bulk Role Update",
                    description: `${user.length} users changed to Superuser(s).`,
                    icon: "bi-check-circle-fill",
                    color: "success",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) updated successfully.`;
                break;

            case "admin":

                await User.updateMany(
                    { _id: { $in: user } },
                    { role: "admin" }
                );


                
                 if (user.role === "admin") {

                    const adminCount = await User.countDocuments({

                        role: "admin"

                    });

                    if (adminCount === 1) {

                        const err = new Error(
                            "The last Admin cannot be demoted."
                        );

                        err.status = 403;

                        err.details =
                            "At least one Admin account must remain in the system.";

                        return next(err);

                    }

                }

                await User.updateMany(
                    { _id: { $in: user } },
                    { role: "admin" }
                );

                await logActivity({
                    action: "Bulk Role Update",
                    description: `${user.length} users changed to Admin(s).`,
                    icon: "bi-check-circle-fill",
                    color: "success",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) updated successfully.`;
                break;

            case "inactive":

                await User.updateMany(
                    { _id: { $in: user } },
                    { subscriptionStatus: "inactive" }
                );

                await logActivity({
                    action: "Bulk subscriptionStatus Update",
                    description: `${user.length} users changed to Inactive`,
                    icon: "bi-gem",
                    color: "warning",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) updated successfully.`;
                break;

            case "active":

                await User.updateMany(
                    { _id: { $in: user } },
                    { subscriptionStatus: "active" }
                );

                await logActivity({
                    action: "Bulk subscriptionStatus Update",
                    description: `${user.length} users changed to Active`,
                    icon: "bi-unlock-fill",
                    color: "warning",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) updated successfully.`;
                break;

                        
            case "expired":

                await User.updateMany(
                    { _id: { $in: user } },
                    { subscriptionStatus: "expired" }
                );

                await logActivity({
                    action: "Bulk subscriptionStatus Update",
                    description: `${user.length} users changed to Expired`,
                    icon: "bi-unlock-fill",
                    color: "warning",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) updated successfully.`;
                break;
    

            case "delete":

                await User.find({
                    _id: { $in: user }
                });

                if (user.role === "superuser") {

                    const superUserCount = await User.countDocuments({

                        role: "superuser"

                    });

                    if (superUserCount === 1) {

                        const err = new Error(
                            "The last Superuser cannot be deleted."
                        );

                        err.status = 403;

                        err.details =
                            "At least one Superuser account must remain in the system.";

                        return next(err);

                    }

                }

                 if (user.role === "admin") {

                    const adminCount = await User.countDocuments({

                        role: "admin"

                    });

                    if (adminCount === 1) {

                        const err = new Error(
                            "The last Admin cannot be deleted."
                        );

                        err.status = 403;

                        err.details =
                            "At least one Admin account must remain in the system.";

                        return next(err);

                    }

                }


                await User.deleteMany({
                    _id: { $in: user }
                });

                await logActivity({
                    action: "Bulk Delete Update",
                    description: `${user.length} users deleted`,
                    icon: "bi-trash-fill",
                    color: "danger",
                    createdBy: req.session.user._id
                });

                message = `${user.length} user(s) deleted successfully.`;
                break;

            default:

                req.flash("error", "Invalid bulk action.");

                return res.redirect("/admin/users");
        }

        req.flash("success", message);

        res.redirect("/admin/users");

    } catch (err) {

        next(err);

    }

};


