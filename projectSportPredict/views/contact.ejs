<%- include("partials/header") -%>

<section class="py-5">
  <div class="container">

    <div class="form-alignment contact-form row g-5">

      <!-- Contact Form -->
      <div class=" col-md-6">
        <h4>Send a Message</h4>
        <form action="/send" method="post">
          <input class="form-control mb-3" placeholder="Name" name="name">
          <input class="form-control mb-3" placeholder="Email" name="email">
          <textarea class="form-control mb-3" placeholder="Message" name="message"></textarea>
          <button class="btn btn-success w-100">Send Message</button>
        </form>
      </div>

      <!-- Consultation Form -->
      <div class="col-md-6">
        <h4>Book Consultation</h4>
        <form action="/booking" method="post">
          <input class="form-control mb-3" placeholder="Company Name" name="companyName">
          <input type="email" class="form-control mb-3" placeholder="Email" name="email">
          <input class="form-control mb-3" placeholder="Phone" name="phone">
          <select class="form-control mb-3" name="enquiry">
            <option>Choose One</option>
            <option>Payment Subscription</option>
            <option>Service</option>
          </select>
          <textarea class="form-control mb-3" placeholder="Details" name="details"></textarea>
          <button class="btn btn-dark w-100">Book Now</button>
        </form>
      </div>

    </div>

  </div>
</section>





<%- include("partials/footer") -%>