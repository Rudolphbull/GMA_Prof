<%- include("partials/header") -%>


        <section id="network-installation" class="py-5">
            <div class="container">

                <div class="text-center mb-5">
                    <h2 class="fw-bold">Premium Prediction Tips</h2>
                    <p class="lead">Stake with a positive mindset.</p>
                    <p class="lead">Do not share this premium prediction tips.</p>
                    <p class="lead">Play across betting platforms.</p>
                </div>
                <div class="row g-4">
                    <% if (user) { %>


                        <h5>Welcome, <%= user.username %></h5>

                    <% } %>

                <h2>Just stake your games using the premium betting tips.</h2>

                    <% if (predictions && predictions.length > 0) { %>

                        <% predictions.forEach(function(post){ %>
                            
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100">
                                    <div class="card-body text-center">

                                        <h5 class="fw-bold mb-3">
                                            Country: <%= post.country %>
                                        </h5>

                                        <p>League: <%= post.league %></p>

                                        <p><%= post.homeTeam %></p>

                                        <p class="fw-bold">VS</p>

                                        <p><%= post.awayTeam %></p>

                                        <p>
                                            <strong>Prediction:</strong>
                                            <%= post.prediction %>
                                        </p>

                                        <p class="small">
                                            <i class="bi bi-clock"></i>
                                            <%= new Date(post.kickoffTime).toLocaleString("en-NG", {
                                                dateStyle: "medium",
                                                timeStyle: "short"
                                            }) %>

                                            &nbsp;|&nbsp;
                                            <strong>predictedBy:</strong>
                                            <i class="bi bi-person-fill"></i>
                                            <%= post.createdBy ? post.createdBy.username : "Unknown" %>
                                        </p>

                                        <p>
                                            <strong>Status:</strong>

                                            <span class="badge bg-info">
                                                <%= post.status %>
                                            </span>
                                        </p>

                                        
                                        <p>
                                            <strong>Result:</strong>
                                            <%= prediction.result %>
                                        </p>
                                                   


                                        <!-- <p>
                                            <strong>kickOffTime:</strong>
                                            <%= post.kickoffTime %> 
                                        </p>

                                        <p>
                                            <strong>predictionBy:</strong>
                                            <%= post.createdBy ? post.createdBy.username : "Unknown" %>
                                        </p> -->
                            

                                    </div>
                                </div>
                            </div>

                                <% }) %>

                            <% } else { %>

                                <div class="text-center py-5">
                                    <h4>No predictions available yet.</h4>
                                </div>

                            <% } %>
                </div>
            </div>          
        </section>






<%- include("partials/footer") -%>