                if (selectAll.checked) {

                    if (!ids.includes(box.value)) {

                        ids.push(box.value);

                    }

                } else {

                    ids = ids.filter(id => id !== box.value);

                }

            });

            saveIds(ids);

        });

    }

    // ============================================
