            if (box.checked) {

                if (!ids.includes(box.value)) {

                    ids.push(box.value);

                }

            } else {

                ids = ids.filter(id => id !== box.value);

            }

            saveIds(ids);

            if (selectAll) {

                selectAll.checked =
                    [...checkboxes].every(c => c.checked);

            }

        });

    });

    // ============================================
    // Remember Bulk Action
    // ============================================

    if (bulkAction) {

        bulkAction.addEventListener("change", () => {

