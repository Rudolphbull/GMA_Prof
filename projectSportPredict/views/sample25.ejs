        // Keep storage in sync
        saveIds(ids);

        bulkForm
            .querySelectorAll(`input[name="${idField}"]`)
            .forEach(input => input.remove());

        ids.forEach(id => {

            const hidden =
                document.createElement("input");

            hidden.type = "hidden";
            hidden.name = idField;
            hidden.value = id;

            bulkForm.appendChild(hidden);

        });

        if (ids.length === 0) {

