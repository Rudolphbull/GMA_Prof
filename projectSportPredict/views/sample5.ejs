The problem
You closed the DOMContentLoaded event too early.

Right here:

    });

});
Everything below that:

const typeCanvas = document.getElementById("predictionTypeChart");
is executing immediately, before the DOM is guaranteed to be ready.

Since the <canvas> may not exist yet, this line:

const typeCanvas = document.getElementById("predictionTypeChart");
returns null, so your if (typeCanvas) fails and no chart is created.

The fix
The doughnut chart should be inside the DOMContentLoaded function.

Your file should look like this structure:

document.addEventListener("DOMContentLoaded", () => {

    // Bar Chart
    ...

    // Doughnut Chart
    ...

});
Notice there is only one closing }); at the very end of the file.

Replace your dashboard.js with this
document.addEventListener("DOMContentLoaded", () => {

    if (!window.dashboardData) return;

    /* ==========================
       Prediction Status Bar Chart
       ========================== */

    const ctx = document
        .getElementById("predictionStatusChart")
        .getContext("2d");

    new Chart(ctx, {

        type: "bar",

        data: {

            labels: [
                "Won",
                "Lost",
                "Pending",
                "Void",
                "Expired"
            ],

            datasets: [{

                label: "Predictions",

                data: [
                    window.dashboardData.won,
                    window.dashboardData.lost,
                    window.dashboardData.pending,
                    window.dashboardData.void,
                    window.dashboardData.expired
                ],

                backgroundColor: [
                    "#198754",
                    "#dc3545",
                    "#ffc107",
                    "#6c757d",
                    "#212529"
                ],

                borderWidth: 1

            }]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {

                    display: false

                }

            },

            scales: {

                y: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0

                    }

                }

            }

        }

    });


    /* ==========================
       Free vs Premium Doughnut
       ========================== */

    const typeCanvas = document.getElementById("predictionTypeChart");

    if (typeCanvas) {

        new Chart(typeCanvas, {

            type: "doughnut",

            data: {

                labels: [

                    "Free",

                    "Premium"

                ],

                datasets: [{

                    data: [

                        window.dashboardData.free,

                        window.dashboardData.premium

                    ],

                    backgroundColor: [

                        "#0d6efd",

                        "#ffc107"

                    ],

                    hoverOffset: 12

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {

                        position: "bottom"

                    }

                }

            }

        });

    }

});
