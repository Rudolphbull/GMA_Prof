const growthData = userGrowth.map(item => item.total);
If MongoDB returns:

[
    { _id: { year: 2026, month: 1 }, total: 5 },
    { _id: { year: 2026, month: 2 }, total: 8 },
    { _id: { year: 2026, month: 3 }, total: 11 }
]
