Step 1: Latest Predictions
Open your admin/dashboard.ejs.

Immediately after the User Statistics section, add:

<!-- Latest Predictions -->

<div class="card shadow mt-5">

    <div class="card-header bg-dark text-white">

        <h4 class="mb-0">
            <i class="bi bi-clock-history"></i>
            Latest Predictions
        </h4>

    </div>

    <div class="card-body">

        <% if(latestPredictions.length > 0){ %>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Fixture</th>

                            <th>Prediction</th>

                            <th>Status</th>

                            <th>Kickoff</th>

                            <th>Author</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% latestPredictions.forEach(function(prediction){ %>

                            <tr>

                                <td>

                                    <strong>

                                        <%= prediction.homeTeam %>

                                    </strong>

                                    vs

                                    <strong>

                                        <%= prediction.awayTeam %>

                                    </strong>

                                </td>

                                <td>

                                    <%= prediction.prediction %>

                                </td>

                                <td>

                                    <%- include("../partials/statusBadge", { prediction }) %>

                                </td>

                                <td>

                                    <%= new Date(prediction.kickoffTime).toLocaleString("en-NG", {
                                        timeZone: "Africa/Lagos",
                                        dateStyle: "medium",
                                        timeStyle: "short"
                                    }) %>

                                </td>

                                <td>

                                    <%= prediction.createdBy ? prediction.createdBy.username : "Unknown" %>

                                </td>

                                <td>

                                    <a
                                        href="/predictions/<%= prediction._id %>/edit?redirectTo=/admin/dashboard"
                                        class="btn btn-warning btn-sm">

                                        Edit

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="alert alert-info">

                No predictions found.

            </div>

        <% } %>

    </div>

</div>
Why this is better than cards
On the homepage, cards are perfect because they're user-facing.

For an administrator, tables are much more efficient.

Imagine 2,000 predictions.

A table lets you scan information quickly.

