            expiredPredictions,
            totalUsers,
            premiumUsers,
            latestPredictions,
            recentUsers
        ] = await Promise.all([

            Prediction.countDocuments(),

            Prediction.countDocuments({
                isPremium: true
            }),

            Prediction.countDocuments({
                isPremium: false
            }),

            Prediction.countDocuments({
                status: "Pending"
            }),

            Prediction.countDocuments({
                status: "Won"
            }),

            Prediction.countDocuments({
                status: "Lost"
            }),

            Prediction.countDocuments({
                status: "Void"
            }),

            Prediction.countDocuments({
                status: "Expired"
            }),

            User.countDocuments(),

            User.countDocuments({
                subscriptionStatus: "active"
            }),

            Prediction.find()
                .sort({ kickoffTime: -1 })
                .limit(5)
                .populate("createdBy", "username"),

            User.find()
                .select("username email role subscriptionStatus createdAt")
                .sort({ createdAt: -1 })
                .limit(5)
        ]);

        const completedPredictions =
        wonPredictions +
        lostPredictions +
        voidPredictions +
        expiredPredictions;

        const winRate = completedPredictions
        ? ((wonPredictions / completedPredictions) * 100).toFixed(1)
        : 0;

        const lossRate = completedPredictions
            ? ((lostPredictions / completedPredictions) * 100).toFixed(1)
            : 0;

        const voidRate = completedPredictions
            ? ((voidPredictions / completedPredictions) * 100).toFixed(1)
            : 0;

        const expiredRate = completedPredictions
            ? ((expiredPredictions / completedPredictions) * 100).toFixed(1)
            : 0;

        res.render("admin/dashboard", {
            pageTitle: "Admin Dashboard",

            totalPredictions,
            premiumPredictions,
            freePredictions,

            pendingPredictions,
            wonPredictions,
            lostPredictions,
            voidPredictions,
            expiredPredictions,

            totalUsers,
            premiumUsers,

            latestPredictions,

            recentUsers

        });

    } catch(err){

        next(err);

    }

};

You're 99% there. 👏

The placement of the calculations is exactly right—they belong after Promise.all() because they depend on the values returned from those database queries.

