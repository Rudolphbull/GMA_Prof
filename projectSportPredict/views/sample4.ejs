const Prediction = require("../models/predictionModel");
const User = require("../models/userModel");

exports.dashboard = async (req, res, next) => {

    try {

        const [
            totalPredictions,
            premiumPredictions,
            freePredictions,
            pendingPredictions,
            wonPredictions,
            lostPredictions,
            voidPredictions,
            expiredPredictions,
            totalUsers,
            premiumUsers,
            latestPredictions
        ] = await Promise.all([

            Prediction.countDocuments(),

            Prediction.countDocuments({ isPremium: true }),

            Prediction.countDocuments({ isPremium: false }),

            Prediction.countDocuments({ status: "Pending" }),

            Prediction.countDocuments({ status: "Won" }),

            Prediction.countDocuments({ status: "Lost" }),

            Prediction.countDocuments({ status: "Void" }),

            Prediction.countDocuments({ status: "Expired" }),

            User.countDocuments(),

            User.countDocuments({
                subscriptionStatus: "active"
            }),

            Prediction.find()
                .sort({ kickoffTime: -1 })
                .limit(5)
                .populate("createdBy", "username")
        ]);

        res.render("admin/dashboard", {
            pageTitle: "Admin Dashboard",

            totalPredictions,
            premiumPredictions,
            freePredictions,

            pendingPredictions,
            wonPredictions,
            lostPredictions,
            voidPredictions,
            expiredPredictions,

            totalUsers,
            premiumUsers,

            latestPredictions
        });

    } catch (err) {

        next(err);

    }

};
Why I like this approach
There are two things I deliberately introduced here.

1. Promise.all()
Instead of waiting for each query one after another, MongoDB can execute all of the independent count queries concurrently. As your application grows to hundreds or thousands of predictions, this will keep the dashboard responsive.

2. A dedicated latestPredictions query
Rather than loading every prediction into memory, we're fetching only the most recent five. That's exactly the kind of data an admin dashboard should surface.

