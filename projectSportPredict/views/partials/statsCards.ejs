<div class="row g-4 mb-5">

    <div class="col-md-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold text-primary">
                    <%= stats.total %>
                </h2>
                <p class="text-muted mb-0">
                    Total Matches
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold text-success">
                    <%= stats.won %>
                </h2>
                <p class="text-muted mb-0">
                    Won
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold text-danger">
                    <%= stats.lost %>
                </h2>
                <p class="text-muted mb-0">
                    Lost
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold text-secondary">
                    <%= stats.void %>
                </h2>
                <p class="text-muted mb-0">
                    Void
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold text-warning">
                    <%= stats.pending %>
                </h2>
                <p class="text-muted mb-0">
                    Pending
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-2">
        <div class="card shadow border-success text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold text-success">
                    <%= stats.accuracy %>%
                </h2>
                <p class="text-muted mb-0">
                    Accuracy
                </p>
            </div>
        </div>
    </div>

</div>