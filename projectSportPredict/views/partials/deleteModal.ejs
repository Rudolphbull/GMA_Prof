
<div
    class="modal fade"
    id="deleteModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5
                    class="modal-title"
                    id="deleteModalTitle"
                >

                    Confirm Action

                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body">

                <p id="deleteMessage">

                    Are you sure you want to delete this record?

                </p>

                <strong id="deleteItemName"></strong>

            </div>

            <div class="modal-footer">

                <div>

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button
                        type="button"
                        class="btn btn-danger"
                        id="confirmDelete">
                        Delete
                    </button>

                </div>

                

            </div>

        </div>

    </div>

</div>
