
<span class="badge
<%= prediction.status === "Won"
    ? "bg-success"
    : prediction.status === "Lost"
    ? "bg-danger"
    : prediction.status === "Void"
    ? "bg-secondary"
    : prediction.status === "Expired"
    ? "bg-dark"
    : "bg-warning text-dark" %>">

    <%= prediction.status %>

</span>