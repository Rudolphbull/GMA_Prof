<%- include("../partials/header") -%>


        <section id="network-installation" class="py-5">

            <div class="container">


                <div class="text-center mb-5">
                    <h2 class="fw-bold">Premium Prediction Tips</h2>
                    <p class="lead">Stake with a positive mindset.</p>
                    <p class="lead">Do not share this premium prediction tips.</p>
                    <p class="lead">Play across betting platforms.</p>
                </div>
                <div class="row g-4">

                <h3 class="mb-4">
                    Today's Premium Betting Tips
                </h3>

                    <% if (predictions && predictions.length > 0) { %>

                        <% predictions.forEach(function(prediction){ %>
                    
                            <%- include("../partials/predictionCard", {
                                prediction,
                                user,
                                redirectTo: "/predictions/premium"
                            }) %>

                            <% }) %>

                            <% } else { %>

                                <div class="text-center py-5">

                                    <h4>No Premium Predictions Available</h4>

                                    <p class="text-muted">
                                        Please check back later. Today's premium tips will be published before kickoff.
                                    </p>

                                </div>

                            <% } %>
                </div>
            </div>          
        </section>






<%- include("../partials/footer") -%>