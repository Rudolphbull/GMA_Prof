As you build the project

Once you create homeRoutes.js, then add:

const homeRoutes = require("./routes/homeRoutes");

app.use("/", homeRoutes);

When you create adminRoutes.js, then add:

const adminRoutes = require("./routes/adminRoutes");

app.use("/admin", adminRoutes);

And later, after creating predictionRoutes.js, add:

const predictionRoutes = require("./routes/predictionRoutes");

app.use("/predictions", predictionRoutes);

I'd also simplify app.js

Eventually, I'd like app.js to contain almost no route definitions. It should mostly be configuration:

// Middleware
app.use(express.urlencoded({ extended: true }));
app.use(express.json());
app.use(express.static("public"));

// Session
app.use(session(...));

// Routes
app.use("/", homeRoutes);
app.use("/auth", authRoutes);
app.use("/admin", adminRoutes);
app.use("/predictions", predictionRoutes);

// 404
app.use((req, res) => {
    res.status(404).render("404", {
        pageTitle: "Page Not Found"
    });
});

