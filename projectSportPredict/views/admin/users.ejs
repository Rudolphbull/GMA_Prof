<%- include("../partials/header") -%>

    <section class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                
                <h1 class="mb-4">

                    Manage Users

                </h1>

                <p class="mb-3">

                    Showing

                    <strong>

                        <%= users.length ? ((currentPage - 1) * limit) + 1 : 0 %>

                    </strong>

                    -

                    <strong>

                        <%= ((currentPage - 1) * limit) + users.length %>

                    </strong>

                    of

                    <strong>

                        <%= totalUsers %>

                    </strong>

                    users

                </p>
                
            </div>


            <a
                href="/auth/signup"
                class="btn btn-success"
            >

                <i class="bi bi-plus-circle"></i>

                New User

            </a>

        </div>


<!--         
        <div class="card shadow">

            

                <div class="table-responsive"> -->

                    <div class="card shadow-sm mb-4">

                            <div class="card-header bg-primary text-white">

                                <h5 class="mb-0 text-white">

                                    <i class="bi bi-funnel me-2"></i>

                                    Filter Users

                                </h5>
                            </div>

                        <div class="card-body">
                    

                            <form 
                            
                                method="GET" 
                                
                                action="/admin/users"
                            >

                        <!-- Row 1 -->
                            <div class="row g-3 mb-3">

                                    <div class="col-md-5">

                                        <label for="search" class="form-label text-light fw-semibold">
                                            <i class="bi bi-search"></i>
                                            Search
                                        </label>

                                        <input
                                            type="text"
                                            name="search"
                                            id="search"
                                            class="form-control"
                                            placeholder="Search username or email..."
                                            value="<%= search || '' %>"
                                        >

                                    </div>


                                    <div class="col-md-3">

                                        <label for="role" class="form-label text-light">
                                            👥 Role
                                        </label>

                                        <select
                                            name="role"
                                            class="form-select"
                                            id="role"
                                        >

                                            <option value="">All Roles</option>

                                            <option
                                                value="user"
                                                <%= role === "user" ? "selected" : "" %>>
                                                User
                                            </option>

                                            <option
                                                value="admin"
                                                <%= role === "admin" ? "selected" : "" %>>
                                                Admin
                                            </option>

                                            <option
                                                value="superuser"
                                                <%= role === "superuser" ? "selected" : "" %>>
                                                Superuser
                                            </option>

                                        </select>

                                    </div>


                                    <div class="col-md-4">

                                        
                                        <label for="subscription" class="form-label text-light fw-semibold">
                                            <i class="bi bi-clipboard-check"></i>

                                            Subscription
                                        </label>


                                        <select
                                            name="subscription"
                                            class="form-select"
                                            id="subscription"
                                        >

                                            <option value="">All Subscriptions</option>

                                            <option
                                                value="active"
                                                <%= subscription === "active" ? "selected" : "" %>>
                                                Premium
                                            </option>

                                            <option
                                                value="inactive"
                                                <%= subscription === "inactive" ? "selected" : "" %>>
                                                Free
                                            </option>

                                            <option
                                                value="expired"
                                                <%= subscription === "expired" ? "selected" : "" %>>
                                                Expired
                                            </option>

                                        </select>

                                    </div>
                            </div>
                            
                            
                                        
                            <!-- Buttons -->
                            <div class="row">

                                <div class="col text-end">


                                    <button class="btn btn-primary btn-lg px-4 me-2">

                                                            
                                            <i class="bi bi-search"></i>

                                            Search

                                    </button>

                                     <a
                                            href="/admin/users"
                                            class="btn btn-outline-secondary"
                                        >

                                        <i class="bi bi-arrow-counterclockwise"></i>

                                            Clear

                                    </a>


                                </div>

                            </div>  

                            </form>

                        </div>

                    </div>


                    <div class="card shadow-sm mb-4">

                        <div class="card-header bg-primary text-white">

                            <h5 class="mb-0">

                                <i class="bi bi-check2-square me-2"></i>

                                Bulk Actions

                            </h5>

                        </div>

                        <div class="card-body">

                            <form
                                id="bulkActionForm"
                                data-module="users"
                                data-id-field="userIds"
                                method="POST"
                                action="/admin/users/bulk"
                            >

                                <div class="row align-items-end mb-4">

                                    <div class="col-md-8">

                                        <label
                                            for="bulkAction"
                                            class="form-label text-light fw-semibold"
                                        >

                                            <i class="bi bi-lightning-charge"></i>

                                            Action

                                        </label>

                                        <select
                                            class="form-select"
                                            id="bulkAction"
                                            name="action"
                                            required
                                        >

                                            <option value="">

                                                Select Action

                                            </option>

                                            <option value="user">

                                                Change to User

                                            </option>

                                            <option value="superuser">

                                                Change to Superuser

                                            </option>

                                            <option value="admin">

                                                Change to Admin

                                            </option>

                                            <option value="inactive">

                                                Change to Inactive

                                            </option>

                                            <option value="active">

                                                Change to Active

                                            </option>

                                            <option value="expired">

                                                Change to Expired

                                            </option>

                                            <option value="delete">

                                                Delete Selected

                                            </option>

                                        </select>

                                    </div>

                                    <div class="col-md-4 text-end">

                                        <button
                                            type="submit"
                                            class="btn btn-success px-4"
                                        >

                                            <i class="bi bi-check-circle"></i>

                                            Apply

                                        </button>

                                    </div>

                            </div>


                                    
                    <div class="col-lg-6">

                        <div class="d-flex gap-2 ">

                            <h5 class="mb-2 text-light">

                                User Records

                            </h5>
                            
                        </div>

                    </div>
                        

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th style="width:40px;">

                                    <input
                                        type="checkbox"
                                        id="selectAll"
                                        class="form-check-input"
                                    >

                                </th>

                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Subscription</th>
                                <th>Activate Subscription</th>
                                <th>Joined</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% if(users.length === 0){ %>

                            <tr>

                                <td colspan="8" class="text-center py-5">

                                    <h5>No users found.</h5>

                                    <p class="text-muted">

                                        Try another search.

                                    </p>

                                </td>

                            </tr>

                            <% } else { %>
    

                            <% users.forEach(function(user){ %>

                                <tr>


                                    
                                    <td>

                                        <input
                                            type="checkbox"
                                            name="userIds"
                                            class="form-check-input bulk-checkbox"
                                            data-bulk-checkbox
                                            value="<%= user._id %>"
                                        >

                                    </td>

                                    <td>

                                        <strong>

                                            <%= user.username %>

                                        </strong>

                                    </td>

                                    <td>

                                        <%= user.email %>

                                    </td>


                                    <td>

                                        <% if(user.role === roles.ADMIN){ %>

                                            <span class="badge bg-danger">

                                                Admin

                                            </span>

                                                <% } else if(user.role === roles.SUPERUSER){ %>

                                                    <span class="badge bg-dark">

                                                        Superuser

                                                    </span>

                                                <% } else { %>

                                                    <span class="badge bg-primary">

                                                        User

                                                    </span>

                                                <% } %>

                                    </td>

                                    <td>

                                                <% if(user.subscriptionStatus === "active"){ %>

                                                    <span class="badge bg-success">

                                                        Premium

                                                    </span>

                                                <% } else { %>

                                                    <span class="badge bg-secondary">

                                                        Free

                                                    </span>

                                                <% } %>

                                    </td>

                                    <td>

                                        <form
                                            action="/admin/users/<%= user._id %>/activate-subscription"
                                            method="POST"
                                        >

                                            <input
                                                type="hidden"
                                                name="plan"
                                                value="Premium">

                                            <input
                                                type="hidden"
                                                name="duration"
                                                value="30">

                                            <button
                                                class="btn btn-success btn-sm">

                                                <i class="bi bi-award-fill"></i>

                                                Activate

                                            </button>

                                        </form>
                                    </td>

                                    <td>

                                        <%= new Date(user.createdAt).toLocaleDateString("en-NG") %>

                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <a
                                                href="/admin/users/<%= user._id %>/edit"
                                                class="btn btn-warning btn-sm"
                                            >

                                                <i class="bi bi-pencil-square"></i>

                                                Edit

                                            </a>
                                            <form
                                                action="/admin/users/<%= user._id %>/delete"
                                                method="POST"
                                                class="delete-form"
                                                data-title="Delete User"
                                                data-message="Are you sure you want to delete this user?"
                                                data-item="<%= user.username %>"
                                                data-button="Delete"
                                                data-button-class="btn-danger"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn btn-danger btn-sm"
                                                >

                                                    <i class="bi bi-trash"></i>

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>


                        <% }) %>

                        <% } %>

                        </tbody>

                    </table>


                        <% if(totalPages > 1){ %>

                            <nav class="mt-4">

                                <ul class="pagination justify-content-center">

                                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">

                                        <a
                                            class="page-link"
                                            href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>&role=<%= role %>&subscription=<%= subscription %>"
                                        >
                                            Previous
                                        </a>

                                    </li>

                                    <% for(let i = 1; i <= totalPages; i++){ %>

                                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                                            <a
                                                class="page-link"
                                                href="/admin/users?page=<%= i %>&search=<%= search %>&role=<%= role %>&subscription=<%= subscription %>"
                                            >
                                                <%= i %>
                                            </a>

                                        </li>

                                    <% } %>

                                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">

                                        <a
                                            class="page-link"
                                            href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>&role=<%= role %>&subscription=<%= subscription %>"
                                        >
                                            Next
                                        </a>

                                    </li>

                                </ul>

                            </nav>

                        <% } %>

                </div>

                </form>
                
            </div>

        </div>

    </section>

    

<%- include("../partials/deleteModal") -%>
<%- include("../partials/footer") -%>