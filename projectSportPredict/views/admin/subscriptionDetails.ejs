
<%- include("../partials/header") -%>

<section class="container-fluid py-4">

    <!-- =========================================
         PAGE HEADER
    ========================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>

            <h3 class="mb-1">
                <i class="bi bi-credit-card-2-front me-2"></i>
                Subscription Details
            </h3>

            <p class="text-light mb-0">
                View complete subscription information.
            </p>

        </div>


        <div class="d-flex gap-2 mt-3 mt-md-0">

            <a
                href="/admin/subscriptions"
                class="btn btn-outline-primary"
            >

                <i class="bi bi-arrow-left me-1"></i>

                Back to Subscriptions

            </a>

        </div>

    </div>



    <!-- =========================================
         SUBSCRIPTION NOTIFICATION
    ========================================== -->

    <% if (typeof messages !== "undefined" && messages.length) { %>

        <% messages.forEach(message => { %>

            <div class="alert alert-info alert-dismissible fade show">

                <%= message %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% }) %>

    <% } %>



    <!-- =========================================
         TOP SUMMARY
    ========================================== -->

    <div class="row g-4 mb-4">


        <!-- =====================================
             USER CARD
        ====================================== -->

        <div class="col-lg-8">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div
                            class="rounded-circle bg-primary bg-opacity-10
                                   d-flex align-items-center justify-content-center
                                   me-3"
                            style="width:60px;height:60px;"
                        >

                            <i class="bi bi-person-fill fs-3 text-primary"></i>

                        </div>


                        <div>

                            <h5 class="mb-1">

                                <%= subscription.user?.username || "Unknown User" %>

                            </h5>

                            <div class="text-light">

                                <i class="bi bi-envelope me-1"></i>

                                <%= subscription.user?.email || "No email available" %>

                            </div>

                        </div>

                    </div>


                    <hr>


                    <div class="row g-3">

                        <div class="col-md-4">

                            <small class="text-light d-block">
                                User Role
                            </small>

                            <strong>
                                <%= subscription.user?.role || "—" %>
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <small class="text-light d-block">
                                User ID
                            </small>

                            <code>
                                <%= subscription.user?._id || "—" %>
                            </code>

                        </div>


                        <div class="col-md-4">

                            <small class="text-light d-block">
                                Subscription ID
                            </small>

                            <code>
                                <%= subscription._id %>
                            </code>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================
             STATUS CARD
        ====================================== -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <small class="text-light d-block mb-2">
                        Subscription Status
                    </small>


                    <% if (subscription.status === "active" && !isExpired) { %>

                        <span class="badge bg-success fs-6 px-3 py-2">

                            <i class="bi bi-check-circle me-1"></i>

                            Active

                        </span>

                    <% } else if (subscription.status === "suspended") { %>

                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">

                            <i class="bi bi-pause-circle me-1"></i>

                            Suspended

                        </span>

                    <% } else if (subscription.status === "expired" || isExpired) { %>

                        <span class="badge bg-danger fs-6 px-3 py-2">

                            <i class="bi bi-x-circle me-1"></i>

                            Expired

                        </span>

                    <% } else { %>

                        <span class="badge bg-secondary fs-6 px-3 py-2">

                            <%= subscription.status %>

                        </span>

                    <% } %>


                    <div class="mt-4">

                        <small class="text-light d-block">
                            Remaining
                        </small>

                        <% if (
                            subscription.status === "active" &&
                            !isExpired
                        ) { %>

                            <h3 class="mb-0">

                                <%= remainingDays %>

                            </h3>

                            <small class="text-light">
                                day<%= remainingDays === 1 ? "" : "s" %> remaining
                            </small>

                        <% } else { %>

                            <h3 class="mb-0">
                                0
                            </h3>

                            <small class="text-light">
                                days remaining
                            </small>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================
         SUBSCRIPTION INFORMATION
    ========================================== -->

    <div class="row g-4 mb-4">


        <!-- =====================================
             PLAN INFORMATION
        ====================================== -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">

                        <i class="bi bi-award me-2"></i>

                        Subscription Information

                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-4">


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Plan
                            </small>

                            <strong>

                                <%= subscription.plan || "—" %>

                            </strong>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Source
                            </small>

                            <strong>

                                <%= subscription.source || "—" %>

                            </strong>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Card
                            </small>

                            <strong>

                                <%= subscription.cardNumber || "—" %>

                            </strong>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Duration
                            </small>

                            <strong>

                                <% if (
                                    subscription.startedAt &&
                                    subscription.expiresAt
                                ) { %>

                                    <%= Math.ceil(
                                        (
                                            new Date(subscription.expiresAt) -
                                            new Date(subscription.startedAt)
                                        ) /
                                        (1000 * 60 * 60 * 24)
                                    ) %> days

                                <% } else { %>

                                    —

                                <% } %>

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================
             DATES
        ====================================== -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">

                        <i class="bi bi-calendar3 me-2"></i>

                        Subscription Dates

                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-4">


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Started
                            </small>

                            <strong>

                                <%= subscription.startedAt
                                    ? new Date(subscription.startedAt).toLocaleString()
                                    : "—"
                                %>

                            </strong>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Expires
                            </small>

                            <strong class="<%= isExpired ? 'text-danger' : '' %>">

                                <%= subscription.expiresAt
                                    ? new Date(subscription.expiresAt).toLocaleString()
                                    : "—"
                                %>

                            </strong>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Created
                            </small>

                            <strong>

                                <%= subscription.createdAt
                                    ? new Date(subscription.createdAt).toLocaleString()
                                    : "—"
                                %>

                            </strong>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-light d-block">
                                Last Updated
                            </small>

                            <strong>

                                <%= subscription.updatedAt
                                    ? new Date(subscription.updatedAt).toLocaleString()
                                    : "—"
                                %>

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================
         ACTIVATION / RENEWAL INFORMATION
    ========================================== -->

    <div class="row g-4 mb-4">


        <!-- =====================================
             ACTIVATED BY
        ====================================== -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">

                        <i class="bi bi-person-check me-2"></i>

                        Activation Information

                    </h5>

                </div>


                <div class="card-body">

                    <% if (subscription.activatedBy) { %>

                        <div class="d-flex align-items-center">

                            <div
                                class="rounded-circle bg-success bg-opacity-10
                                       d-flex align-items-center justify-content-center
                                       me-3"
                                style="width:50px;height:50px;"
                            >

                                <i class="bi bi-person-check text-success fs-4"></i>

                            </div>


                            <div>

                                <strong class="d-block">

                                    <%= subscription.activatedBy.username || "Unknown" %>

                                </strong>

                                <small class="text-light">

                                    <%= subscription.activatedBy.email || "No email available" %>

                                </small>

                            </div>

                        </div>

                    <% } else { %>

                        <p class="text-light mb-0">
                            No activation administrator recorded.
                        </p>

                    <% } %>

                </div>

            </div>

        </div>



        <!-- =====================================
             RENEWED FROM
        ====================================== -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">

                        <i class="bi bi-arrow-repeat me-2"></i>

                        Renewal Information

                    </h5>

                </div>


                <div class="card-body">

                    <% if (subscription.renewedFrom) { %>

                        <p class="mb-2">

                            <small class="text-light d-block">
                                Renewed From Subscription
                            </small>

                            <code>

                                <%= subscription.renewedFrom._id || subscription.renewedFrom %>

                            </code>

                        </p>


                        <% if (subscription.renewedFrom.plan) { %>

                            <p class="mb-0">

                                <small class="text-light d-block">
                                    Previous Plan
                                </small>

                                <strong>

                                    <%= subscription.renewedFrom.plan %>

                                </strong>

                            </p>

                        <% } %>

                    <% } else { %>

                        <p class="text-light mb-0">

                            This subscription has no recorded renewal source.

                        </p>

                    <% } %>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================
         NOTES
    ========================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-transparent">

            <h5 class="mb-0">

                <i class="bi bi-journal-text me-2"></i>

                Notes

            </h5>

        </div>


        <div class="card-body">

            <% if (subscription.notes) { %>

                <p class="mb-0">

                    <%= subscription.notes %>

                </p>

            <% } else { %>

                <p class="text-light mb-0">

                    No notes have been recorded for this subscription.

                </p>

            <% } %>

        </div>

    </div>



    <!-- =========================================
         ADMIN ACTIONS
    ========================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-transparent">

            <h5 class="mb-0">

                <i class="bi bi-lightning-charge me-2"></i>

                Subscription Actions

            </h5>

        </div>


        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">


                <!-- =================================
                     Activate / Reactivate
                ================================== -->

                <% if (
                    subscription.status === "suspended" ||
                    subscription.status === "expired" ||
                    subscription.status === "inactive"
                ) { %>

                    <a
                        href="/admin/users/<%= subscription.user?._id %>/edit"
                        class="btn btn-success"
                    >

                        <i class="bi bi-play-circle me-1"></i>

                        Activate / Reactivate

                    </a>

                <% } %>



                <!-- =================================
                     Renew
                ================================== -->

                <form
                    action="/subscriptions/<%= subscription._id %>/renew"
                    method="POST"
                    class="d-inline">


                    <button
                        class="btn btn-outline-primary btn-sm"
                        title="Renew Subscription">

                        <i class="bi bi-arrow-repeat"></i>

                        Renew

                    </button>

                </form>



                <!-- =================================
                     Back
                ================================== -->

                <a
                    href="/admin/subscriptions"
                    class="btn btn-outline-secondary"
                >

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

            </div>

        </div>

    </div>

</section>


<%- include("../partials/footer") -%>

