<div class="card shadow border-0 mt-5">

    <!-- Card Header -->
    <div class="card-header bg-white">

        <h4 class="mb-0 text-muted">

            <i class="bi bi-clock-history me-2 text-primary"></i>

            Recent Activity

        </h4>

    </div>

    <!-- Scrollable Activity Feed -->
    <div class="card-body p-0 activity-feed">

        <% if (recentActivities.length === 0) { %>

            <div class="text-center p-5">

                <i class="bi bi-clock-history display-4 text-muted"></i>

                <h5 class="mt-3">

                    No Recent Activity

                </h5>

                <p class="text-muted mb-0">

                    Activities will appear here as administrators manage the system.

                </p>

            </div>

        <% } else { %>

            <ul class="list-group list-group-flush">

                <% recentActivities.forEach(activity => { %>

                    <li class="list-group-item activity-item border-start border-4 border-<%= activity.color %>">

                        <div class="d-flex align-items-start">

                            <!-- Activity Icon -->
                            <div class="activity-icon bg-<%= activity.color %> me-3">

                                <i class="bi <%= activity.icon %>"></i>

                            </div>

                            <!-- Activity Details -->
                            <div class="flex-grow-1">

                                <div class="d-flex justify-content-between align-items-center flex-wrap mb-1">

                                    <div>

                                        <h6 class="mb-0 d-inline">

                                            <%= activity.action %>

                                        </h6>

                                        <span class="badge bg-light text-dark ms-2">

                                            <%= activity.action.split(" ")[0] %>

                                        </span>

                                    </div>

                                </div>

                                <p class="mb-1 text-muted">

                                    <%= activity.description %>

                                </p>

                                <small class="text-secondary">

                                    <% if (activity.createdBy) { %>

                                        <i class="bi bi-person-fill me-1"></i>

                                        <strong>

                                            <%= activity.createdBy.username %>

                                        </strong>

                                        &nbsp;•&nbsp;

                                    <% } %>

                                    <i class="bi bi-clock me-1"></i>

                                    <%= activity.timeAgo %>

                                </small>

                            </div>

                        </div>

                    </li>

                <% }) %>

            </ul>

        <% } %>

    </div>

    <!-- Card Footer -->
    <div class="card-footer bg-white text-center">

        <a
            href="/admin/activities"
            class="text-decoration-none fw-semibold">

            View All Activities

            <i class="bi bi-arrow-right ms-1"></i>

        </a>

    </div>

</div>