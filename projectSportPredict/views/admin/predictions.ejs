<%- include("../partials/header") -%>

<section class="container py-5">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div class="form-alignment">

            <h1 class="mb-1">
                Manage Predictions
            </h1>

            <p class="mb-0">

                Showing

                <strong>
                    <%= predictions.length ? ((currentPage - 1) * limit) + 1 : 0 %>
                </strong>

                -

                <strong>
                    <%= ((currentPage - 1) * limit) + predictions.length %>
                </strong>

                of

                <strong>
                    <%= totalPredictions %>
                </strong>

                predictions

            </p>

        </div>

        <a
            href="/predictions/new"
            class="btn btn-success"
        >

            <i class="bi bi-plus-circle"></i>

            New Prediction

        </a>

    </div>


    <div class="card shadow-sm mb-4">

    <div class="card-header bg-primary text-white">

        <h5 class="mb-0 text-white">

            <i class="bi bi-funnel"></i>

            Filter Predictions

        </h5>

    </div>

    <div class="card-body">

    

        <form
            method="GET"
            action="/admin/predictions"
        >

            <!-- Row 1 -->
            <div class="row g-3 mb-3">

                <div class="col-md-5">
                    
                    
                    <label for="search" class="form-label text-light fw-semibold">
                        <i class="bi bi-search"></i>
                        Search
                    </label>

                    <input
                        type="text"
                        name="search"
                        id="search"
                        class="form-control"
                        placeholder="Search teams, league or country..."
                        value="<%= search %>"
                    >

                </div>

                <div class="col-md-3">

                    <label for="country" class="form-label text-light fw-semibold">
                        <i class="bi bi-globe"></i>
                        Country
                    </label>

                    <select
                        name="country"
                        class="form-select"
                        id="country"
                    >

                        <option value="">All Countries</option>

                        <% countries.forEach(item => { %>

                            <option
                                value="<%= item %>"
                                <%= country === item ? "selected" : "" %>
                            >

                                <%= item %>

                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="col-md-4">

                    <label for="league" class="form-label text-light fw-semibold">
                        <i class="bi bi-trophy"></i>
                        League
                    </label>

                    <select
                        name="league"
                        class="form-select"
                        id="league"
                    >

                        <option value="">All Leagues</option>

                        <% leagues.forEach(item => { %>

                            <option
                                value="<%= item %>"
                                <%= league === item ? "selected" : "" %>
                            >

                                <%= item %>

                            </option>

                        <% }) %>

                    </select>

                </div>

            </div>

            <!-- Row 2 -->
            <div class="row g-3 mb-3">

                    <div class="col-md-4">

                        <label for="status" class="form-label text-light fw-semibold">
                            <i class="bi bi-clipboard-check"></i>

                            Status
                        </label>

                        <select
                            name="status"
                            class="form-select"
                            id="status"
                        >

                            <option value="">All Status</option>

                            <option value="Pending" <%= status === "Pending" ? "selected" : "" %>>
                                Pending
                            </option>

                            <option value="Won" <%= status === "Won" ? "selected" : "" %>>
                                Won
                            </option>

                            <option value="Lost" <%= status === "Lost" ? "selected" : "" %>>
                                Lost
                            </option>

                            <option value="Void" <%= status === "Void" ? "selected" : "" %>>
                                Void
                            </option>

                            <option value="Expired" <%= status === "Expired" ? "selected" : "" %>>
                                Expired
                            </option>

                        </select>

                    </div>

                    <div class="col-md-4">

                        <label for="premium" class="form-label text-light fw-semibold">
                            <i class="bi bi-gem"></i>
                            Prediction Type
                        </label>

                        <select
                            name="premium"
                            class="form-select"
                            id="premium"
                        >

                            <option value="">All Predictions</option>

                            <option value="true" <%= premium === "true" ? "selected" : "" %>>
                                Premium
                            </option>

                            <option value="false" <%= premium === "false" ? "selected" : "" %>>
                                Free
                            </option>

                        </select>

                    </div>

                    <div class="col-md-4">

                        <label for="sort" class="form-label text-light fw-semibold">
                            <i class="bi bi-arrow-down-up"></i>
                            Sort By
                        </label>

                        <select
                            name="sort"
                            class="form-select"
                            id="sort"
                        >

                            <option value="kickoff-desc" <%= sort === "kickoff-desc" ? "selected" : "" %>>
                                Newest Kickoff
                            </option>

                            <option value="kickoff-asc" <%= sort === "kickoff-asc" ? "selected" : "" %>>
                                Oldest Kickoff
                            </option>

                            <option value="odds-desc" <%= sort === "odds-desc" ? "selected" : "" %>>
                                Highest Odds
                            </option>

                            <option value="odds-asc" <%= sort === "odds-asc" ? "selected" : "" %>>
                                Lowest Odds
                            </option>

                            <option value="confidence-desc" <%= sort === "confidence-desc" ? "selected" : "" %>>
                                Highest Confidence
                            </option>

                            <option value="confidence-asc" <%= sort === "confidence-asc" ? "selected" : "" %>>
                                Lowest Confidence
                            </option>

                            <option value="created-desc" <%= sort === "created-desc" ? "selected" : "" %>>
                                Recently Added
                            </option>

                            <option value="created-asc" <%= sort === "created-asc" ? "selected" : "" %>>
                                Oldest Added
                            </option>

                        </select>

                    </div>

                </div>

                <!-- Row 3 -->
                <div class="row g-3 mb-4">

                    <div class="col-md-3">

                        <label for="minOdds" class="form-label text-light fw-semibold">
                            <i class="bi bi-graph-down-arrow"></i>
                            Min Odds
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            name="minOdds"
                            id="minOdds"
                            class="form-control"
                            placeholder="Min Odds"
                            value="<%= minOdds %>"
                        >

                    </div>

                    <div class="col-md-3">

                        <label for="maxOdds" class="form-label text-light fw-semibold">
                            <i class="bi bi-graph-up-arrow"></i>
                            Max Odds
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            name="maxOdds"
                            id="maxOdds"
                            class="form-control"
                            placeholder="Max Odds"
                            value="<%= maxOdds %>"
                        >

                    </div>

                    <div class="col-md-3">

                        <label for="dateFrom" class="form-label text-light fw-semibold">
                            <i class="bi bi-calendar-event"></i>
                            Date From
                        </label>

                        <input
                            type="date"
                            name="dateFrom"
                            id="dateFrom"
                            class="form-control"
                            value="<%= dateFrom %>"
                        >

                    </div>

                    <div class="col-md-3">

                        <label for="dateTo" class="form-label text-light fw-semibold">
                            <i class="bi bi-calendar-check"></i>
                            Date To
                        </label>

                        <input
                            type="date"
                            name="dateTo"
                            id="dateTo"
                            class="form-control"
                            value="<%= dateTo %>"
                        >

                    </div>

                </div>

                <!-- Buttons -->
                <div class="row">

                    <div class="col text-end">

                        <button
                            type="submit"
                            class="btn btn-primary btn-lg px-4 me-2"
                        >

                            <i class="bi bi-search"></i>

                            Filter

                        </button>

                        <a
                            href="/admin/predictions"
                            class="btn btn-outline-secondary"
                        >

                            <i class="bi bi-arrow-counterclockwise"></i>

                            Reset

                        </a>

                    </div>

                </div>

            </form>

            

        </div>

    </div>

        <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-check2-square me-2"></i>

                Bulk Actions

            </h5>

        </div>

        <div class="card-body">

            <form
                id="bulkActionForm"
                method="POST"
                action="/admin/predictions/bulk"
            >

                <div class="row align-items-end">

                    <div class="col-md-8">

                        <label
                            for="bulkAction"
                            class="form-label text-light fw-semibold"
                        >

                            <i class="bi bi-lightning-charge"></i>

                            Action

                        </label>

                        <select
                            class="form-select"
                            id="bulkAction"
                            name="action"
                            required
                        >

                            <option value="">

                                Select Action

                            </option>

                            <option value="won">

                                Mark as Won

                            </option>

                            <option value="lost">

                                Mark as Lost

                            </option>

                            <option value="void">

                                Mark as Void

                            </option>

                            <option value="premium">

                                Make Premium

                            </option>

                              <option value="free">

                                Make Free

                            </option>

                            <option value="delete">

                                Delete Selected

                            </option>

                        </select>

                    </div>

                    <div class="col-md-4 text-end">

                        <button
                            type="submit"
                            class="btn btn-success px-4"
                        >

                            <i class="bi bi-check-circle"></i>

                            Apply

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th style="width:40px;">

                                <input
                                    type="checkbox"
                                    id="selectAll"
                                    class="form-check-input"
                                >

                            </th>
                            <th>Match</th>
                            <th>Prediction</th>
                            <th>Odds</th>
                            <th>Status</th>
                            <th>Premium</th>
                            <th>Kickoff</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% if(predictions.length === 0){ %>

                            <tr>

                                <td colspan="8" class="text-center py-5">

                                    <h5>No predictions found.</h5>

                                    <p class="text-muted mb-0">

                                        Try adjusting your search or filters.

                                    </p>

                                </td>

                            </tr>

                        <% } else { %>

                            <% predictions.forEach(prediction => { %>

                                <tr>

                                    <td>

                                        <input
                                            type="checkbox"
                                            name="predictionIds"
                                            class="form-check-input prediction-checkbox"
                                            value="<%= prediction._id %>"
                                        >

                                    </td>

                                    <td>

                                        <strong>

                                            <%= prediction.homeTeam %>

                                        </strong>

                                        <br>

                                        <small class="text-muted">

                                            vs

                                            <%= prediction.awayTeam %>

                                        </small>

                                        <br>

                                        <small class="text-secondary">

                                            <%= prediction.league %>

                                        </small>

                                    </td>

                                    <td>

                                        <%= prediction.prediction %>

                                    </td>

                                    <td>

                                        <%= prediction.odds %>

                                    </td>

                                    <td>

                                        <% if(prediction.status === "Won"){ %>

                                            <span class="badge bg-success">

                                                Won

                                            </span>

                                        <% } else if(prediction.status === "Lost"){ %>

                                            <span class="badge bg-danger">

                                                Lost

                                            </span>

                                        <% } else if(prediction.status === "Void"){ %>

                                            <span class="badge bg-secondary">

                                                Void

                                            </span>

                                        <% } else if(prediction.status === "Expired"){ %>

                                            <span class="badge bg-dark">

                                                Expired

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <% if(prediction.isPremium){ %>

                                            <span class="badge bg-success">

                                                Premium

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-primary">

                                                Free

                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <%= new Date(prediction.kickoffTime).toLocaleString("en-NG") %>

                                    </td>

                                    <td>

                                        <a
                                            href="/predictions/<%= prediction._id %>/edit"
                                            class="btn btn-warning btn-sm mb-1"
                                        >

                                            <i class="bi bi-pencil-square"></i>

                                            Edit

                                        </a>

                                        <form
                                            action="/admin/predictions/<%= prediction._id %>/delete"
                                            method="POST"
                                            class="d-inline delete-form"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-danger btn-sm delete-btn"
                                                data-name="<%= prediction.homeTeam %> vs <%= prediction.awayTeam %>"
                                            >
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>

                                        </form>
                                        
                                    </td>

                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>
                </table>

            </div>

            
            <% if (totalPages > 1) { %>

                <nav class="mt-4">

                    <ul class="pagination justify-content-center">

                        <!-- Previous -->

                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">

                            <a
                                class="page-link"
                                href="/admin/predictions?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>&premium=<%= premium %>&country=<%= country %>&league=<%= league %>&minOdds=<%= minOdds %>&maxOdds=<%= maxOdds %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&sort=<%= sort %>"
                            >
                                Previous
                            </a>

                        </li>

                        <!-- Page Numbers -->

                        <% for (let i = 1; i <= totalPages; i++) { %>

                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                                <a
                                    class="page-link"
                                    href="/admin/predictions?page=<%= i %>&search=<%= search %>&status=<%= status %>&premium=<%= premium %>&country=<%= country %>&league=<%= league %>&minOdds=<%= minOdds %>&maxOdds=<%= maxOdds %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>&sort=<%= sort %>"
                                >
                                    <%= i %>
                                </a>

                            </li>

                        <% } %>

                        <!-- Next -->

                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">

                            <a
                                class="page-link"
                                href="/admin/predictions?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>&premium=<%= premium %>&country=<%= country %>&league=<%= league %>&minOdds=<%= minOdds %>&maxOdds=<%= maxOdds %>&dateFrom=<%= dateFrom %>&dateTo=<%= dateTo %>"
                            >
                                Next
                            </a>

                        </li>

                    </ul>

                </nav>

            <% } %>

            
        </div>

    </div>

</section>

<script src="/js/bulk-actions.js"></script>
<%- include("../partials/deleteModal") %>
<%- include("../partials/footer") -%>