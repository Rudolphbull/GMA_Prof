<%- include("partials/header") %>


    <section class="py-5">
        <div class="container">
            <div class="form-alignment row g-5">
                <div class="col-md-4">
                    <h1>Registration Form</h1>
                    <form action="/auth/signup" method="POST">
                                <!-- <span class="details">Username</span> -->
                                <input class="form-control mb-3" type="text" name="username" placeholder="Enter your username" autocomplete="off" required>

                                <!-- <span class="details">Email</span> -->
                                <input class="form-control mb-3" type="email" name="email" placeholder="Enter your email" autocomplete="off" required>
                    
                                <!-- <span class="details">Password</span> -->
                                <input class="form-control mb-3" type="password" name="password" placeholder="Enter your password" autocomplete="off" required>
                                
                                <!-- <span class="details">Confirm Password</span> -->
                                <input class="form-control mb-3" type="password" name="confirmPassword" placeholder="Confirm your password" autocomplete="off" required>

                                <select name="role" class="form-control mb-3">
                                    <option value="user">User</option>
                                    <option value="superuser">Super User</option>
                                    <option value="admin">Admin</option>
                                </select>
                    
                        <div class="button">
                            <input class="btn btn-success w-100" type="submit" value="Register">
                        </div>
                    </form>
                </div>
            
            </div>

        </div>

    </section>
       
<%- include("partials/footer") %>





























